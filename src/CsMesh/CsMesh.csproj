<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CsMesh</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>csmesh</ToolCommandName>
    <AssemblyName>csmesh</AssemblyName>
    <PackageId>CsMesh</PackageId>
    <Version>0.0.1</Version>
    <Authors>Vali (naser) Rafinia</Authors>
    <Description>Structural answer engine for C# codebases. Answers agent questions about call paths, interface implementations and change blast radius under a hard token budget.</Description>
    <PackageProjectUrl>https://github.com/nRafinia/CsMesh</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nRafinia/CsMesh</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>csharp;dotnet;roslyn;call-graph;code-analysis;agent;ai;static-analysis;cli;tool</PackageTags>
    <NoWarn>$(NoWarn);IL3000;IL2104</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

</Project>
